# 服务器配置
HOST=127.0.0.1
PORT=8082
DEBUG=false

# 目录配置，请按本机环境修改
MUSIC_SOURCE_DIR=D:/path/to/music/source
MUSIC_OUTPUT_DIR=D:/path/to/music/output
MUSIC_ARCHIVE_DIR=D:/path/to/music/archive

# 双音乐库补齐目标与 musicdl 内部服务
DUAL_LIBRARY_NAS_DIR=D:/path/to/feiniu/library
DUAL_LIBRARY_APPLE_IMPORT_DIR=D:/Music/Apple Music/Media/Automatically Add to Apple Music
MUSICDL_BASE_URL=http://127.0.0.1:5000
MUSICDL_SERVICE_TOKEN=replace-with-a-long-random-token

# 留空时使用项目根目录下的 config、logs、temp
# CONFIG_DIR=D:/path/to/MusicFlow/config
# LOGS_DIR=D:/path/to/MusicFlow/logs
# TEMP_DIR=D:/path/to/MusicFlow/temp

# FFmpeg 工具路径
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 任务配置
MAX_CONCURRENT_TASKS=2
FFMPEG_THREADS=2
FILE_STABLE_SECONDS=30
