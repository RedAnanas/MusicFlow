# 服务器配置
HOST=127.0.0.1
PORT=8082
DEBUG=false

# 目录配置，请按本机环境修改
MUSIC_SOURCE_DIR=D:/path/to/music/source
MUSIC_OUTPUT_DIR=D:/path/to/music/output
MUSIC_ARCHIVE_DIR=D:/path/to/music/archive

# 留空时使用项目根目录下的 config、logs、temp
# CONFIG_DIR=D:/path/to/MusicFlow/config
# LOGS_DIR=D:/path/to/MusicFlow/logs
# TEMP_DIR=D:/path/to/MusicFlow/temp

# FFmpeg 工具路径
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 任务配置
MAX_CONCURRENT_TASKS=2
FFMPEG_THREADS=2
FILE_STABLE_SECONDS=30
