# 服务器配置
HOST=127.0.0.1
PORT=8082
DEBUG=false

# 目录配置，请按本机环境修改
MUSIC_SOURCE_DIR=/mnt/d/Music/source
MUSIC_OUTPUT_DIR=/mnt/d/Music/output
MUSIC_ARCHIVE_DIR=/mnt/d/Music/archive

# 留空时使用项目根目录下的 config、logs、temp
# CONFIG_DIR=/mnt/d/path/to/MusicFlow/config
# LOGS_DIR=/mnt/d/path/to/MusicFlow/logs
# TEMP_DIR=/mnt/d/path/to/MusicFlow/temp

# FFmpeg 工具路径
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 任务配置
MAX_CONCURRENT_TASKS=2
FFMPEG_THREADS=2
FILE_STABLE_SECONDS=30
